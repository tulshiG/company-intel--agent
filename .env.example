# =============================================================================
# CompanyIntel Agent — environment configuration
# Copy this file to ".env" and fill in whichever FREE keys you have.
# The app auto-detects what's available and picks the best free provider.
# Nothing here costs money on the free tiers linked below.
# =============================================================================

# ---- LLM provider (reasoning / synthesis) ----------------------------------
# Pick ONE. Both are free, no credit card required.
LLM_PROVIDER=gemini            # "gemini" or "groq"

# Google Gemini — free tier via Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# gemini-2.0-flash was shut down June 2026 -- do not use it.
# Current free-tier-eligible models (as of Aug 2026): gemini-3.1-flash-lite
# (recommended default: fast, stable, explicitly free-tier eligible) or
# gemini-2.5-flash (still active, scheduled for deprecation Oct 2026).
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq — free tier, very fast, open models (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Web research provider --------------------------------------------------
# If TAVILY_API_KEY is set, Tavily's free tier (1,000 searches/month, built
# for AI agents) is used. If it's left blank, the app automatically falls
# back to DuckDuckGo search, which needs NO key at all and is fully free.
TAVILY_API_KEY=

# ---- Misc --------------------------------------------------------------------
# Turn caching off if you want to force a fresh run every time (uses more API calls)
ENABLE_CACHE=true
